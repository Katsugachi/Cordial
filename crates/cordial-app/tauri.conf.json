{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cordial",
  "version": "0.1.0",
  "identifier": "app.cordial.local",
  "build": {
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "npm --prefix ../ui run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Cordial",
        "width": 1180,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "backgroundColor": "#f4f3eb"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "A local agent powered by LFM3.",
    "longDescription": "Cordial is a private, on-device agent. It answers questions, checks facts on the web, drives a browser and works with your files, all with LFM3-VL-2B running locally through llama.cpp.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "windows": {
      "nsis": {
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  }
}
